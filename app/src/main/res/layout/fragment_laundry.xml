<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Laundry"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:background="@android:color/transparent"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E3F2FD"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:elevation="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌤"
                android:textSize="32sp"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvLaundryIndexTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘의 세탁 지수"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/tvLaundryIndexDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="날씨 데이터를 불러오는 중입니다..."
                    android:textSize="13sp"
                    android:textColor="#1565C0"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenMultiSelect"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#4CAF50"
            android:text="👕 세탁 코스 가이드"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnTimeRecommend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF"
                    android:padding="20dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏱ 세탁 및 건조 시점 추천"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="오염도와 날씨를 분석해 최적의 타이밍을 제안해요"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="〉" android:textColor="#CCCCCC" android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnLaundryHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF"
                    android:padding="20dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋 나의 세탁 기록 히스토리"
                            android:textStyle="bold"
                            android:textColor="#1565C0"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="언제 어떤 코스로 세탁했는지 다시 확인해요"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="〉" android:textColor="#CCCCCC" android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnManageWasher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFF3E0"
                    android:padding="20dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱 내 세탁기 관리 및 등록"
                            android:textStyle="bold"
                            android:textColor="#E65100"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="새로운 세탁기를 스캔하고 등록하세요"
                            android:textColor="#F57C00"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="〉" android:textColor="#E65100" android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>