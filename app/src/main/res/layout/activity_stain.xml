<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◀"
        android:textSize="20sp"
        android:textColor="#000000"
        android:padding="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="얼룩 분석 요청"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 얼룩을 스캔해주세요"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnScanStain"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:text="📷\n얼룩 스캔하기"
                android:textSize="18sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#1976D2"
                android:layout_marginBottom="30dp"
                app:strokeColor="#1976D2"
                app:strokeWidth="1dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 추가 정보를 적어주세요 (선택)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etStainInfo"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:hint="예: 커피를 흘린 지 1시간 정도 되었고, 따뜻한 물로 살짝 닦아냈어요."
                android:gravity="top"
                android:padding="15dp"
                android:background="@android:drawable/edit_text"
                android:textSize="14sp"
                android:layout_marginBottom="40dp"/>

            <Button
                android:id="@+id/btnShowResult"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="AI 분석 결과 확인하기"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>